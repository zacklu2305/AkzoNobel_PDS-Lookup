@import "tailwindcss";

@layer base {
  :root {
    --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", "Segoe UI", Roboto, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    --accent-blue: #00227A;
    --accent-blue-hover: #0a35a3;
    --glass-alpha: 0.55;
    --glass-blur: 24px;
  }

  @media (max-width: 767px) {
    :root {
      --glass-blur: 12px;
    }
  }

  html,
  body {
    font-family: var(--font-sans);
    background-color: #eef2fb;
    color: #1d1d1f;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4 {
    letter-spacing: -0.01em;
  }
}

.font-mono-num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

/* Fixed ambient color blobs behind Liquid Glass surfaces (static, no animation) */
.liquid-bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background-color: #eef2fb;
}

.liquid-blob-navy {
  position: absolute;
  top: -120px;
  left: -80px;
  width: 620px;
  height: 620px;
  border-radius: 9999px;
  background: radial-gradient(circle, rgba(0, 34, 122, 0.3) 0%, rgba(0, 34, 122, 0) 70%);
  filter: blur(80px);
}

.liquid-blob-cobalt {
  position: absolute;
  top: 22%;
  right: -120px;
  width: 680px;
  height: 680px;
  border-radius: 9999px;
  background: radial-gradient(circle, rgba(61, 107, 220, 0.25) 0%, rgba(61, 107, 220, 0) 70%);
  filter: blur(90px);
}

.liquid-blob-sky {
  position: absolute;
  bottom: -160px;
  left: 28%;
  width: 720px;
  height: 720px;
  border-radius: 9999px;
  background: radial-gradient(circle, rgba(143, 176, 255, 0.3) 0%, rgba(143, 176, 255, 0) 70%);
  filter: blur(90px);
}

/* Apple Liquid Glass primary surfaces (.glass-nav and .glass-panel) */
.glass-nav,
.glass-panel {
  background: rgba(255, 255, 255, var(--glass-alpha));
  backdrop-filter: blur(var(--glass-blur)) saturate(180%);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6);
  border-radius: 24px;
}

.glass-nav {
  position: sticky;
  top: 12px;
  z-index: 30;
}

.glass-panel {
  position: relative;
}

/* 1px light gradient border (brighter top-left, dimmer bottom-right) */
.glass-nav::before,
.glass-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.85) 0%,
    rgba(255, 255, 255, 0.35) 50%,
    rgba(255, 255, 255, 0.12) 100%
  );
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  pointer-events: none;
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-nav,
  .glass-panel {
    background: rgba(255, 255, 255, 0.88);
  }
}

/* Translucent pill buttons and slicer chips — NO backdrop-filter (nested inside glass) */
.glass-pill {
  background: rgba(255, 255, 255, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.6);
  color: #1d1d1f;
  border-radius: 9999px;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}

.glass-pill:hover {
  background: rgba(255, 255, 255, 0.75);
  border-color: rgba(0, 34, 122, 0.22);
