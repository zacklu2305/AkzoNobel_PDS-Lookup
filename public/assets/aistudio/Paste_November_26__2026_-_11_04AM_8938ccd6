// 6. Outline Pill Action Button (src/components/ExportPptxButton.tsx — complete file)
import { useState } from 'react';
import { Download } from 'lucide-react';
import {
  PPTX_EXPORT_ENABLED,
  exportDashboardToPptx,
  type ExportDashboardPptxParams,
} from '../utils/pptxExport';

export function ExportPptxButton(props: ExportDashboardPptxParams) {
  const [exporting, setExporting] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  if (!PPTX_EXPORT_ENABLED) {
    return null;
  }

  const handleClick = async () => {
    if (exporting) return;
    setExporting(true);
    setErrorMsg(null);
    try {
      await exportDashboardToPptx(props);
    } catch (err) {
      const reason =
        err instanceof Error && err.message.trim()
          ? err.message.trim()
          : 'Export failed. Please try again.';
      setErrorMsg(reason);
    } finally {
      setExporting(false);
    }
  };

  return (
    <div className="flex justify-end">
      <div className="glass-translate-wrap">
        {errorMsg && (
          <span role="alert" className="text-[12px] text-[#ff3b30]">
            {errorMsg}
          </span>
        )}
        <button
          type="button"
          disabled={exporting}
          onClick={() => void handleClick()}
          className="glass-translate-btn gap-1.5 disabled:opacity-50"
        >
          <Download className="h-3.5 w-3.5" />
          {exporting ? 'Exporting...' : 'Export PPTX'}
        </button>
      </div>
    </div>
  );
}

// 7. Outline Toggle Pill Button (src/components/TranslationToggleButton.tsx — complete file)
import { useEffect, useState } from 'react';
import { SETTINGS, UI_TEXT } from '../config';
import type { DisplayLanguage, TranslationsState } from '../types';

interface TranslationToggleButtonProps {
  value: DisplayLanguage;
  onChange: (next: DisplayLanguage) => void;
  translationsState: TranslationsState;
}

export function TranslationToggleButton({
  value,
  onChange,
  translationsState,
}: TranslationToggleButtonProps) {
  const [showUnavailableNote, setShowUnavailableNote] = useState(false);

  const isUnavailable =
    translationsState.status === 'unavailable' ||
    translationsState.status === 'empty';

  // Clear note once translations become ready
  useEffect(() => {
    if (translationsState.status === 'ready') {
      setShowUnavailableNote(false);
    }
  }, [translationsState.status]);

  if (!SETTINGS.TRANSLATION_SWITCH_ENABLED) {
    return null;
  }

  const isEnglishActive = value === 'english' && !isUnavailable;
  const displayUnavailableNote =
    showUnavailableNote || (value === 'english' && isUnavailable);

  const handleClick = () => {
    if (value === 'english') {
      setShowUnavailableNote(false);
      onChange('original');
      return;
    }

    if (isUnavailable) {
      setShowUnavailableNote(true);
      return;
    }

    setShowUnavailableNote(false);
    onChange('english');
  };

  return (
    <div className="glass-translate-wrap">
      {displayUnavailableNote && (
        <span className="text-[12px] text-[#86868b]">
          {UI_TEXT.translationSwitch.unavailableNote}
        </span>
      )}
      <button
        type="button"
        aria-pressed={isEnglishActive}
        onClick={handleClick}
        className={`glass-translate-btn ${
          isEnglishActive ? 'glass-translate-btn-active' : ''
        }`}
      >
        {isEnglishActive
          ? UI_TEXT.translationSwitch.showOriginal
          : UI_TEXT.translationSwitch.translateToEnglish}
      </button>
    </div>
  );
}

