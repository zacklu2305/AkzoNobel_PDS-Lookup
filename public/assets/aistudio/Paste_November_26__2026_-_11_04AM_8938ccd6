    },
    {
      label: m.columnsVsCurrent,
      value: `${formatInteger(diff.fileColumnCount)} vs ${formatInteger(diff.currentColumnCount)}`,
    },
  ];

  return (
    <div className="divide-y divide-black/[0.06] rounded-[12px] bg-white/75 border border-black/[0.06]">
      {rows.map((item) => (
        <div
