// 1. Confirmation Modal Dialog (src/components/ConfirmDialog.tsx — complete file)
import { useEffect, type ReactNode } from 'react';
import { UI_TEXT } from '../config';

interface ConfirmDialogProps {
  open: boolean;
  title: string;
  message: string;
  confirmLabel: string;
  cancelLabel?: string;
  confirmTone?: 'primary' | 'danger';
  busy?: boolean;
  onConfirm: () => void;
  onCancel: () => void;
  children?: ReactNode;
}

export function ConfirmDialog({
  open,
  title,
  message,
  confirmLabel,
  cancelLabel = UI_TEXT.admin.cancelButton,
  confirmTone = 'primary',
  busy = false,
  onConfirm,
  onCancel,
  children,
}: ConfirmDialogProps) {
  useEffect(() => {
    if (!open) return;
    function onKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape' && !busy) {
        onCancel();
      }
    }
    document.addEventListener('keydown', onKeyDown);
    return () => document.removeEventListener('keydown', onKeyDown);
  }, [open, busy, onCancel]);

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/30 p-4"
      onClick={() => {
        if (!busy) onCancel();
      }}
      role="dialog"
      aria-modal="true"
      aria-labelledby="confirm-dialog-title"
    >
      <div
        className="glass-panel w-full max-w-lg p-6"
        onClick={(e) => e.stopPropagation()}
      >
        <h3
          id="confirm-dialog-title"
          className="text-[17px] font-semibold text-[#1d1d1f] tracking-[-0.01em]"
        >
          {title}
        </h3>
        <p className="mt-2 text-[14px] leading-relaxed text-[#525257]">{message}</p>

        {children && <div className="mt-4">{children}</div>}

        <div className="mt-6 flex items-center justify-end gap-3">
          <button
            type="button"
            disabled={busy}
            onClick={onCancel}
            className="glass-btn-secondary px-5 py-2.5 text-[13px] font-medium disabled:opacity-50 whitespace-nowrap shrink-0"
          >
            {cancelLabel}
          </button>
          <button
            type="button"
            disabled={busy}
            onClick={onConfirm}
            className={`${
              confirmTone === 'danger'
                ? 'rounded-full bg-[#ff3b30] hover:bg-[#e0352b] text-white shadow-[0_4px_12px_rgba(255,59,48,0.28)] transition-all'
                : 'glass-btn-primary'
            } px-5 py-2.5 text-[13px] font-medium disabled:opacity-50 whitespace-nowrap shrink-0`}
          >
            {confirmLabel}
          </button>
        </div>
      </div>
    </div>
  );
}

// 2. Floating Chart Tooltip Popup (src/components/DashboardTab.tsx)
interface CustomTooltipPayloadItem {
  name?: string;
  value?: number;
  color?: string;
  payload?: Record<string, unknown>;
}

interface CustomTooltipProps {
  active?: boolean;
  label?: string;
  payload?: CustomTooltipPayloadItem[];
  mode: 'count' | 'countStacked' | 'eur' | 'aging100' | 'agingCount';
}

function ChartTooltip({ active, label, payload, mode }: CustomTooltipProps) {
  if (!active || !payload || payload.length === 0) return null;

  const nonZero = payload.filter((entry) => Number(entry.value ?? 0) !== 0);
  if (nonZero.length === 0) return null;

  const rawPayload = nonZero[0]?.payload ?? {};
  const headerLabel =
    typeof rawPayload.__tooltipLabel === 'string'
      ? rawPayload.__tooltipLabel
      : label;
  const totalValue = nonZero.reduce((acc, item) => {
    if (mode === 'aging100') {
      const name = String(item.name ?? '');
      return acc + Number(rawPayload[`__cnt_${name}`] ?? 0);
    }
    return acc + Number(item.value ?? 0);
  }, 0);

  return (
    <div className="rounded-[16px] bg-white/[0.96] px-3.5 py-2.5 shadow-[0_8px_24px_rgba(0,0,0,0.14)] border border-black/[0.08] text-[12px] min-w-[176px]">
      <div className="font-semibold text-[#1d1d1f] mb-1.5 pb-1 border-b border-black/[0.06]">
        {headerLabel}
      </div>
      <div className="space-y-1">
        {nonZero.map((entry) => {
          const val = Number(entry.value ?? 0);
          const name = String(entry.name ?? '');
          let formatted = '';
          if (mode === 'count' || mode === 'countStacked' || mode === 'agingCount') {
            formatted = formatInteger(val);
          } else if (mode === 'eur') {
            formatted = `${formatEur(val, 2)} EUR`;
          } else {
            const cnt = Number(rawPayload[`__cnt_${name}`] ?? 0);
            formatted = `${formatInteger(cnt)} (${formatPercent(val, 1)})`;
          }

          return (
            <div key={name} className="flex items-center justify-between gap-4">
              <span className="flex items-center gap-1.5 text-[#1d1d1f] truncate">
                <span
                  className="h-2.5 w-2.5 shrink-0 rounded-[3px]"
                  style={{ backgroundColor: entry.color }}
                />
                <span className="truncate">{name}</span>
              </span>
              <span className="font-mono-num font-medium text-[#1d1d1f] whitespace-nowrap">
                {formatted}
              </span>
            </div>
          );
        })}
      </div>
      {(nonZero.length > 1 || mode === 'countStacked') && (
        <div className="mt-1.5 pt-1.5 border-t border-black/[0.06] flex items-center justify-between gap-4 font-semibold text-[#1d1d1f]">
          <span>{UI_TEXT.charts.totalLabel}</span>
          <span className="font-mono-num whitespace-nowrap">
            {mode === 'eur'
              ? `${formatEur(totalValue, 2)} EUR`
              : formatInteger(totalValue)}
          </span>
        </div>
      )}
    </div>
  );
}


