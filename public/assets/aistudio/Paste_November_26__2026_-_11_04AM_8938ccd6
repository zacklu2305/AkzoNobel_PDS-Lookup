              aria-pressed={isSelected}
              onClick={() => onToggle(opt.value)}
              className={`${
                isSelected ? 'glass-pill-active' : 'glass-pill'
              } px-3 py-1 text-[12px] font-medium whitespace-nowrap shrink-0`}
            >
              {opt.label}
